{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/ps-contact-form-block",
	"version": "0.1.0",
	"title": "Pet Stop Contact Form Block",
	"category": "widgets",
	"icon": "forms",
	"description": "Custom contact form created for Pet Stop of Virginia/Central Florida.",
	"example": {},
	"supports": {
		"color": {
			"background": true,
			"text": true
		},
		"html": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"attributes": {
		"inputs": { "type": "array",
			"default": [
				{ 
				"name": "name",
				"label": "Full name",
				"id": "contact_name",
				"type": "text",
				"page": 1,
				"required": true
				},
				{ 
				"name": "email",
				"label": "Email address",
				"id": "contact_email",
				"type": "email",
				"page": 1,
				"required": true
				},
				{ 
				"name": "phone",
				"label": "Phone number",
				"id": "contact_phone",
				"type": "tel",
				"page": 1,
				"required": true
				},
				{ 
				"name": "zip",
				"label": "ZIP code",
				"id": "zip",
				"type": "text",
				"page": 1,
				"required": true
				},
				{ 
				"name": "address1",
				"label": "Address",
				"id": "address",
				"type": "text",
				"page": 4,
				"required": true
				},
				{ 
				"name": "city",
				"label": "City",
				"id": "city",
				"type": "text",
				"page": 4,
				"required": true
				},
				{ 
				"name": "state",
				"label": "State",
				"id": "state",
				"type": "text",
				"page": 4,
				"required": true
				},
				{ 
				"name": "zip",
				"label": "ZIP code",
				"id": "zip",
				"type": "text",
				"page": 4,
				"required": true
				}
			]},
		"message": { "type": "boolean", "default": true},
		"compliance": { "type": "string", "default": "We'll never share your info with anyone.\nBy providing your phone number, you agree to receive text messages from Pet Stop.\nMessage and data rates may apply. You can reply STOP at any time to opt out." },
		"pages": { "type": "integer", "default": 6 },
		"currentPage": { "type": "integer", "default": 0 },
		"heading": { "type": "array" },
		"content": { "type": "array" },
		"existingCustomer": { "type": "boolean", "default": false }
	},
	"textdomain": "ps-contact-form-block",
	"editorScript": "file:./scripts/index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./scripts/style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./scripts/view.js"
}